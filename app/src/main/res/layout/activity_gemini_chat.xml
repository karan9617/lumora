<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F4F4"
    tools:context=".geminichat.GeminiChatActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#E1000000"
        app:subtitleTextColor="@android:color/white"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:menu="@menu/notesai_menu" >
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:queryHint="Search your notes"
            app:queryBackground="@android:color/transparent"
            android:textColorHint="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:layout_gravity="right"
            />

    </com.google.android.material.appbar.MaterialToolbar>
    <EditText
        android:id="@+id/noteTitleEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:background="@android:color/transparent"
        android:hint="@string/notepad_title"
        android:textColor="#706E6E"
        android:inputType="textCapSentences"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:textSize="22sp"
        android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:layout_above="@+id/input_layout"
        android:padding="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestion_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/input_layout"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />


    <ProgressBar
        android:id="@+id/listeningProgress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"

        android:visibility="gone"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/white" />
    <ProgressBar
        android:id="@+id/chat_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/input_layout"
        android:layout_width="match_parent"
        android:background="#000000"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_voice_icon"

            android:padding="10dp"
            android:soundEffectsEnabled="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_voice_bg"
            android:id="@+id/voiceicon" />
        <EditText
            android:id="@+id/chat_input_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textColorHint="@color/selected_note_background"
            android:hint="Ask NotesAI..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="20"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send"
            android:padding="8dp" />

    </LinearLayout>

</RelativeLayout>