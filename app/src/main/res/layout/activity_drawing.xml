<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DrawingActivity">

    <!-- The custom drawing view will fill the entire screen, from edge to edge -->
    <com.example.keyboardai.ui.DrawingView
        android:id="@+id/drawing_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- A sleek container for all the drawing controls at the bottom of the screen -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_controls_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">



            <!-- Pen/Brush size options -->
            <LinearLayout
                android:id="@+id/pen_size_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageButton
                    android:id="@+id/eraser"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="medium_pen_button_description"
                    android:src="@drawable/ic_eraser"
                    android:soundEffectsEnabled="true"
                    />
                <ImageButton
                    android:id="@+id/pen_small"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="small_pen_button_description"
                    android:src="@drawable/ic_small_pen"
                    android:soundEffectsEnabled="true"
                    />



                <ImageButton
                    android:id="@+id/pen_large"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="large_pen_button_description"
                    android:src="@drawable/ic_large_pen"
                    android:soundEffectsEnabled="true"
                    />
                <ImageButton
                    android:id="@+id/sprayPaintBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="spray_paint_button_description"
                    android:src="@drawable/ic_spray"
                    android:soundEffectsEnabled="true"
                    />
                <ImageButton
                    android:id="@+id/rectangleBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/ic_rectangle_vector"
                    android:contentDescription="spray_paint_button_description"
                    android:src="@drawable/ic_rectangle_vector"
                    android:soundEffectsEnabled="true"
                    />
                <!-- New button for uploading an image -->
                <ImageButton
                    android:id="@+id/uploadImageBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/button_background_rounded"
                    android:contentDescription="upload_image_button_description"
                    android:src="@drawable/baseline_attach_file_24" />
            </LinearLayout>

            <!-- Color options -->
            <LinearLayout
                android:id="@+id/color_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- This SeekBar is now more prominent and styled, placed above the control card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/stroke_width_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <SeekBar
            android:id="@+id/stroke_width_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:max="100"
            android:progress="10" />

    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/button_background_transparent"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="SAVE"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- New Sliding Color Picker Layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/color_slider_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="#E6DBDB"
        tools:ignore="RtlHardcoded">

        <HorizontalScrollView
            android:id="@+id/color_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginRight="20dp"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/color_group_slider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- A variety of color buttons to choose from -->
                <ImageButton
                    android:id="@+id/color_grey"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_grey"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="white_color_button_description" />

                <ImageButton
                    android:id="@+id/color_black"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_black"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="black_color_button_description" />

                <ImageButton
                    android:id="@+id/color_red"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_red"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="red_color_button_description" />

                <ImageButton
                    android:id="@+id/color_blue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_blue"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="blue_color_button_description" />

                <ImageButton
                    android:id="@+id/color_green"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_green"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="green_color_button_description" />

                <ImageButton
                    android:id="@+id/color_yellow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_yellow"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="yellow_color_button_description" />

                <ImageButton
                    android:id="@+id/color_purple"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_purple"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="purple_color_button_description" />

                <ImageButton
                    android:id="@+id/color_orange"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_orange"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="orange_color_button_description" />

                <ImageButton
                    android:id="@+id/color_pink"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_pink"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="pink_color_button_description" />

                <ImageButton
                    android:id="@+id/color_teal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_teal"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="teal_color_button_description" />
                <ImageButton
                    android:id="@+id/color_maroon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_maroon"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="teal_color_button_description" />
                <ImageButton
                    android:id="@+id/color_color1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_picker_color_one"
                    android:soundEffectsEnabled="true"
                    android:contentDescription="teal_color_button_description" />

            </LinearLayout>

        </HorizontalScrollView>

    </androidx.cardview.widget.CardView>
    <!-- Custom Dialog for Save/Discard functionality -->
    <RelativeLayout
        android:id="@+id/save_discard_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unsaved Changes"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"/>

                <TextView
                    android:id="@+id/dialog_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Do you want to save your drawing?"
                    android:textSize="16sp"
                    android:layout_gravity="center_horizontal"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:id="@+id/dialog_discard_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="DISCARD"
                        android:textColor="@android:color/holo_red_dark"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:id="@+id/dialog_cancel_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="CANCEL"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:id="@+id/dialog_save_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:text="SAVE"
                        android:textColor="@android:color/holo_blue_dark"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
