<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".operationactivity.TrashActivity">

    <TextView
        android:id="@+id/textViewTrashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trash"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Button to restore all notes from trash -->
    <Button
        android:id="@+id/buttonRestoreAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restore All"
        app:layout_constraintTop_toTopOf="@id/textViewTrashTitle"
        app:layout_constraintBottom_toBottomOf="@id/textViewTrashTitle"
        app:layout_constraintEnd_toStartOf="@id/buttonEmptyTrash" />

    <!-- Button to permanently empty the trash -->
    <Button
        android:id="@+id/buttonEmptyTrash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Empty Trash"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/textViewTrashTitle"
        app:layout_constraintBottom_toBottomOf="@id/textViewTrashTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView to display the list of deleted notes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTrash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/textViewTrashTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        tools:listitem="@layout/note_item" />

</androidx.constraintlayout.widget.ConstraintLayout>
