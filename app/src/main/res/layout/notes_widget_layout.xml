<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8A2A3C3"
    android:id="@+id/layout_widget_id"
   >


    <!-- Notes List -->
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:paddingTop="4dp"
        android:visibility="visible" />

    <!-- Empty View for when there are no notes -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/no_notes_text"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <!-- This is the new layout for displaying a single note -->
    <LinearLayout
        android:id="@+id/widget_single_note_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"

        android:visibility="gone">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:padding="7dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/latoregular"
            />

        <TextView
            android:id="@+id/widget_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textColor="@color/black"
            android:fontFamily="@font/latoregular"
            android:padding="7dp"
            android:textSize="15sp" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_single_drawing_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/image_drawing"
            />

    </LinearLayout>
</RelativeLayout>
