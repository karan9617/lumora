<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8F1ECC9"
    android:id="@+id/layout_widget_id"
    android:padding="8dp">

    <!-- Header and New Note Button -->
    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingBottom="8dp">


    </RelativeLayout>

    <!-- Notes List -->
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:paddingTop="4dp"
        android:visibility="visible" />

    <!-- Empty View for when there are no notes -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="16dp"
        android:text="No notes yet. Tap + to add one!"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <!-- This is the new layout for displaying a single note -->
    <LinearLayout
        android:id="@+id/widget_single_note_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_single_drawing_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/image_drawing"
            />

    </LinearLayout>
</RelativeLayout>
