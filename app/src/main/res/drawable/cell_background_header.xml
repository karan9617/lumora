<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- A light gray color for the background to make it look like a header -->
    <solid android:color="#F0F0F0" />

    <!-- A subtle border for a clean, grid-like appearance -->
    <stroke
        android:width="1dp"
        android:color="#C0C0C0" />

    <!-- Rounded corners, matching the CardView in the layout -->
    <corners android:radius="0dp" />

</shape>