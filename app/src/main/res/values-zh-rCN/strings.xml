    <string name="instruction_heading">使用说明</string>
    <string name="notes_main_text">Notes AI 提供各种功能，使用户的笔记制作体验更加顺畅。</string>
    <string name="text_instruction_view_note">1. 记笔记:\n- 轻松创建文本笔记。\n- 有效地组织您的想法。</string>
    <string name="voice_notes_instruction">2. 语音笔记:\n- 直接从应用内录制语音笔记。\n- 方便快速捕捉想法。</string>
    <string name="pin_notes_instruction">3. 置顶笔记:\n- 将重要笔记置顶。\n- 快速访问高优先级笔记。</string>
    <string name="sort_notes_instruction">4. 笔记排序:\n- 按日期、标题或优先级对笔记进行排序。\n- 保持您的笔记井然有序。</string>
    <string name="ai_completition_instruction">5. AI 自动完成:\n- 使用 AI 自动完成您的笔记。\n- 有效地生成想法或摘要。</string>
    <string name="drawing_instruction_note">6. 绘图:\n- 直接在您的笔记中进行素描和绘图。\n- 为您的笔记添加视觉元素。</string>
    <string name="string_instruction">7. 涂鸦:\n- 创建更详细的草图或图表。\n- 非常适合头脑风暴或视觉笔记。</string>

    <string name="notes_ai_policies_line1">NotesAI 政策描述了 Notes AI Android 应用程序的隐私惯例。</string>
    <string name="notes_ai_policies_line2">NotesAI 是一款软件，允许用户以个性化笔记的形式保存数据和个人信息。</string>
    <string name="notes_ai_policies_line3">以下描述了处理用户信息方式的全面指南：</string>
    <string name="information_heading">信息收集和使用。</string>
    <string name="notes_ai_1">在使用 NotesAI 时，用户可以存储数据和信息，将其保持在一个应用程序中。</string>
    <string name="notes_ai_2">以笔记的形式，数据可以在以后被访问，以供将来参考。</string>
    <string name="notes_ai_3">用户共享的个人信息将存储在用户的手机中，NotesAI 应用程序或任何其他第三方将无法访问。</string>
    <string name="notes_ai_4">只有用户有资格使用和查看他或她的信息，只要用户没有手动分享它。</string>
    <string name="notes_ai_5">信息在用户的手机中是安全的。</string>
    <string name="notes_ai_6">我们对您内容的访问。</string>
    <string name="notes_ai_7">在使用 NotesAI 时，用户可以以文本形式存储语音笔记数据。</string>
    <string name="notes_ai_8">为了提供此功能，NotesAI 使用了用户手机的麦克风权限。</string>
    <string name="notes_ai_9">从麦克风收集的数据存储在用户的手机中。</string>
    <string name="notes_ai_10">数据在用户的手机中是安全的，可以检索以供将来使用。</string>

