<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.noteaiapp.keyboardai"
    >



    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Remove AD_ID permission added by Firebase/Google Play Services -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:extractNativeLibs="false"


        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/logotransparent"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logotransparent"

        android:supportsRtl="true"
        android:theme="@style/Theme.KeyboardAi"
        tools:targetApi="31">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths2" />
        </provider>
        <receiver
            android:name=".widget.NotesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_widget_info" />
        </receiver>
        <activity
            android:name=".widget.AppWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.KeyboardAi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".widget.NotesWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <activity
            android:name=".ExcelSheetActivity"
            android:exported="false"
            android:label="@string/title_activity_excel_sheet"
            android:theme="@style/Theme.KeyboardAi" />
        <activity
            android:name=".NotesListActivity"
            android:exported="true"

            android:theme="@style/Theme.KeyboardAi"></activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KeyboardAi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Notepad"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"

        android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".imagenote.ImageNoteActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".operationactivity.ArchivesActivity"
            android:exported="true"
            android:label="@string/nav_archive"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true"
            android:label="@string/login_label"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".auth.SignUpActivity"
            android:exported="true"
            android:label="@string/login_label"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".customnote.GeminiNoteActivity"
            android:exported="true"
            android:label="@string/login_label"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".mindmap.MindMapActivity"
            android:exported="true"
            android:label="@string/mindmaplabel"
            android:windowSoftInputMode="adjustResize"

            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".DrawingActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".operationactivity.Feedback"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".listitems.ListItemsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".FolderNotesActivity"
            android:exported="true"

            android:theme="@style/Theme.KeyboardAi"></activity>
        <activity
            android:name=".operationactivity.TrashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".operationactivity.PoliciesActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".operationactivity.InstructionsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".calendar.CalendarActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".camera.CameraActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
    </application>

</manifest>